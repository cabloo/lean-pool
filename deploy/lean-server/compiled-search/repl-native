#!/bin/sh
# repl-native - what Kimina starts each worker as, with the compiled search step
# (docs/compiled-search.md). make.sh installs it in ../native; compose.compiled-search.yaml names it.
#
# It starts the image's own REPL with one library loaded into that process first: linarith's
# search step as compiled code (build.sh makes it from the C files of the image this container
# runs). Lean finds a compiled function by its symbol name and calls it in place of interpreting
# the same function, so nothing else has to be told. What Lean accepts does not change: the search
# only proposes numbers, and Lean's kernel checks the proof built from them exactly as before.
#
# The image's REPL is LEAN_NATIVE_REPL, or else the path in `repl-path` beside this file (make.sh
# reads it from the image). The library is loaded ONLY when it was compiled from the very C files
# this container holds: the build wrote their names (`sources`) and one hash over them
# (`built-from`), and the hash is taken again here. Anything else (no library, another image under
# the same mount, a file that cannot be read) starts the plain REPL, which is what the server ran
# before.
#
# LD_PRELOAD is given to the REPL alone. The library removes it from the environment as it is
# loaded (build.sh), so a program a tactic starts (`bv_decide` runs a SAT solver) does not
# inherit it.
here=${LEAN_NATIVE_DIR:-$(dirname "$0")}
real=${LEAN_NATIVE_REPL:-}
if [ -z "$real" ] && [ -r "$here/repl-path" ]; then
  IFS= read -r real < "$here/repl-path"
fi
if [ -z "$real" ]; then
  echo "repl-native: no REPL to start: LEAN_NATIVE_REPL is not set and $here/repl-path is missing (run compiled-search/make.sh)" >&2
  exit 127
fi
library=$here/linarith-search.so
if [ -r "$library" ] && [ -r "$here/sources" ] && [ -s "$here/built-from" ]; then
  # shellcheck disable=SC2046  # one path a line, none with a space: build.sh refuses any other
  now=$(sha256sum $(cat "$here/sources") 2>/dev/null | sha256sum | cut -d ' ' -f 1)
  if [ "$now" = "$(cat "$here/built-from")" ]; then
    LD_PRELOAD=$library exec "$real" "$@"
  fi
fi
exec "$real" "$@"
