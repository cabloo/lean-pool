#!/usr/bin/env bash
# kimina-firewall - the firewall rules of one Kimina Lean Server instance on this host.
#
# The installers put it at /usr/local/sbin/kimina-firewall (root:root
# 0755); one systemd unit per instance runs it at boot. Per instance (second argument; none = instance 1):
#   KIMINA-LAN[-NAME]     inbound: the instance's port only from the LAN subnet and the docker bridges.
#                         Docker-published ports are forwarded, so ufw's INPUT rules never see them;
#                         DOCKER-USER does. The destination port is rewritten before this chain runs, so
#                         it matches the ORIGINAL port.
#   KIMINA-EGRESS[-NAME]  outbound: the container may answer connections, never start one. Lean code can
#                         run programs while a file is checked, so this keeps anything that gets in from
#                         reaching the LAN, this host or the internet. Applied in DOCKER-USER (traffic
#                         leaving through the host) and INPUT (traffic addressed to the host itself).
#   KIMINA-FRONT[-NAME]   only for an instance behind a TLS front (KIMINA_FW_FRONT_ADDRESS in its
#                         firewall.conf; lean-pool): the front, and nothing else, may start a
#                         TCP connection to its own network, which is how it reaches the Lean server and
#                         the usage agent beside it. The egress rule names the whole network, the front
#                         included, so without this it would drop the front's connections wherever the
#                         kernel passes bridged traffic through iptables. The front has a FIXED address
#                         and the Lean server cannot take it (no capability to change or forge one), so
#                         the Lean server still starts no connection at all. Forwarded traffic only: the
#                         front may not call this host either.
# An instance without a front gets exactly the first two.
set -euo pipefail
instance=${2:-}
[[ "$instance" =~ ^[a-z0-9]{0,16}$ ]] || { echo "kimina-firewall: bad instance name" >&2; exit 2; }
suffix=${instance:+-$(echo "$instance" | tr '[:lower:]' '[:upper:]')}
LAN=KIMINA-LAN$suffix
EGRESS=KIMINA-EGRESS$suffix
FRONT=KIMINA-FRONT$suffix
. "/srv/kimina${instance:+-$instance}/firewall.conf"
match=(-p tcp -m conntrack --ctorigdstport "$KIMINA_FW_PORT" --ctdir ORIGINAL)
from_container=(-s "$KIMINA_FW_CONTAINER_NET")
within_network=(-s "$KIMINA_FW_CONTAINER_NET" -d "$KIMINA_FW_CONTAINER_NET")
front_address=${KIMINA_FW_FRONT_ADDRESS:-}
[ -z "$front_address" ] || [[ "$front_address" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] \
  || { echo "kimina-firewall: KIMINA_FW_FRONT_ADDRESS must be an IPv4 address" >&2; exit 2; }
remove() {
  while iptables -C DOCKER-USER "${match[@]}" -j "$LAN" 2>/dev/null; do
    iptables -D DOCKER-USER "${match[@]}" -j "$LAN"
  done
  for chain in DOCKER-USER INPUT; do
    while iptables -C "$chain" "${from_container[@]}" -j "$EGRESS" 2>/dev/null; do
      iptables -D "$chain" "${from_container[@]}" -j "$EGRESS"
    done
  done
  while iptables -C DOCKER-USER "${within_network[@]}" -j "$FRONT" 2>/dev/null; do
    iptables -D DOCKER-USER "${within_network[@]}" -j "$FRONT"
  done
  for chain in "$LAN" "$EGRESS" "$FRONT"; do
    iptables -F "$chain" 2>/dev/null || true
    iptables -X "$chain" 2>/dev/null || true
  done
}
case "${1:-apply}" in
  apply)
    iptables -nL DOCKER-USER >/dev/null 2>&1 || { echo "kimina-firewall: no DOCKER-USER chain (is docker running?)" >&2; exit 1; }
    remove
    iptables -N "$LAN"
    iptables -A "$LAN" -s "$KIMINA_FW_SUBNET" -j RETURN
    iptables -A "$LAN" -s 172.16.0.0/12 -j RETURN      # docker bridge networks
    iptables -A "$LAN" -s 127.0.0.0/8 -j RETURN
    iptables -A "$LAN" -j DROP
    iptables -I DOCKER-USER 1 "${match[@]}" -j "$LAN"
    iptables -N "$EGRESS"
    iptables -A "$EGRESS" -m conntrack --ctstate ESTABLISHED,RELATED -j RETURN   # replies only
    iptables -A "$EGRESS" -j DROP
    iptables -I DOCKER-USER 1 "${from_container[@]}" -j "$EGRESS"
    iptables -I INPUT 1 "${from_container[@]}" -j "$EGRESS"
    if [ -n "$front_address" ]; then
      # Inserted LAST, so it sits above the egress jump: the front's own connections to its network are
      # accepted before the egress rule sees them. Everything else from this network still meets it.
      iptables -N "$FRONT"
      iptables -A "$FRONT" -s "$front_address" -p tcp -j ACCEPT
      iptables -I DOCKER-USER 1 "${within_network[@]}" -j "$FRONT"
    fi
    ;;
  remove) remove ;;
  *) echo "usage: kimina-firewall apply|remove [INSTANCE]" >&2; exit 2 ;;
esac
