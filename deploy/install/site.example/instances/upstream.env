# Instance `upstream`: the upstream Kimina Lean Server image, pulled rather than built.
#   sudo bash install.sh --site DIR --instance upstream                       the Lean server, with its usage agent
#   sudo bash install.sh --site DIR --proxy upstream --admit-cases CASES      the pool's front door, in front of it
#
#   INSTANCE_IMAGE_TAG     the local tag: the image runs as <SITE_PREFIX>/kimina:<this>
#   INSTANCE_IMAGE         an image to pull (a reference with a digest pins it exactly). An instance built here
#                          names its recipe instead: INSTANCE_DOCKERFILE and INSTANCE_BUILD_FILES, files in the
#                          site directory beside site.env.
#   INSTANCE_PORT          the Lean server's port on the host; its usage agent's is this + 200
#   INSTANCE_SUBNET        the server's own Docker network, which the firewall names (a /24 the host does not route)
#   INSTANCE_WORKERS       how many checks it runs at once
#   INSTANCE_WORKER_MEMORY the address space one worker may take
#   INSTANCE_CPUS          the CPUs the server may use
#   INSTANCE_MIN_FREE_GB   the free space an install needs where Docker keeps its images
# The workers, worker memory, CPUs and subnet only fill in what the instance's kimina.env does not have yet:
# after the first install, change them there (or with kimina-ctl set-repls N and set-cpus N).
INSTANCE_IMAGE_TAG=kimina-2.0.0
INSTANCE_IMAGE=projectnumina/kimina-lean-server:2.0.0
INSTANCE_PORT=18001
INSTANCE_SUBNET=172.29.54.0/24
INSTANCE_WORKERS=8
INSTANCE_WORKER_MEMORY=8G
INSTANCE_CPUS=8
INSTANCE_MIN_FREE_GB=20
